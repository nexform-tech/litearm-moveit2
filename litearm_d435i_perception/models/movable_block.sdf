<?xml version="1.0"?>
<!--
  movable_block.sdf — 可通过 ROS 接口实时改位的演示物块。

  由 launch 在启动时插入（默认开启），scripts/movable_block.py 通过
  /gazebo/set_entity_state 改写它的世界位姿。物块移动后，D435i 的深度
  相机立即在新位置渲染它，/camera/depth/color/points 与 MoveIt Octomap
  随之更新，用来演示“环境变了 -> 点云/地图跟着变”。

  <static>true</static> 是刻意的：
    · 不受重力影响，改到哪就停在哪；
    · 不会被机械臂推走，演示可重复。

  ⚠ 只有 visual，没有 collision（和 dynamic_obstacle.sdf 同理）：演示验证的
  是“相机看到 -> 点云 -> Octomap -> 重规划”，不是物理接触。保留 collision
  时，如果重规划晚于手臂到达，Gazebo 会把手臂顶住，JTC 以轨迹误差 abort，
  验收不可控。视觉外观仍然会被深度相机渲染成点云，感知链路完整。

  视觉尺寸 0.12 m，略大于 Octomap 分辨率 (0.02 m) 的 6 倍，点云落格稳定；
  橙红色与工位里的红/绿方块区分开，RViz 里一眼能认出来。
-->
<sdf version="1.6">
  <model name="movable_block">
    <static>true</static>

    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>0.12 0.12 0.12</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.45 0.05 1</ambient>
          <diffuse>1.00 0.58 0.10 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
