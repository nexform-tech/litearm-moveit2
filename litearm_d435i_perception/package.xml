<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>litearm_d435i_perception</name>
  <version>0.1.0</version>
  <description>
    Intel RealSense D435i 深度相机在 Gazebo Classic 中的仿真与 MoveIt 2 避障演示：
    固定外置相机感知机械臂 + LiteGrip 夹爪周围环境，点云经 Octomap 进入
    PlanningScene；支持位姿/关节目标规划、执行中障碍更新后的取消与重规划，
    以及可选的 Gazebo 动态障碍（默认关闭）。
  </description>
  <maintainer email="TODO@email.com">TODO</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <!-- cloud_envelope_filter：MoveIt 碰撞模型 + ShapeMask 的 C++ 包络过滤 -->
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_perception</depend>
  <depend>eigen</depend>

  <!-- 组合模型（臂 + 夹爪）、SRDF、静态场景、Gazebo 控制器与 world 都复用旧包 -->
  <exec_depend>litearm_obstacle_avoidance</exec_depend>
  <exec_depend>litearm_moveit_config</exec_depend>
  <exec_depend>litearm_ros2_control</exec_depend>
  <exec_depend>litearm_description</exec_depend>
  <exec_depend>litegrip_description</exec_depend>

  <!-- MoveIt 2 -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Gazebo Classic：世界、ros2_control、深度相机插件、运行时改障碍位姿 -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>

  <!-- 控制 / 规划 / 感知接口 -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>octomap_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <depend>sensor_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <depend>tf2_ros</depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
